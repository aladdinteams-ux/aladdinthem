{
  "name": "larijani-stone-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for the Larijani Stone WordPress / Elementor theme",
  "scripts": {
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/css/tailwind.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/css/tailwind.css --watch",
    "build:vendor": "node build/copy-vendor.js"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "bootstrap-icons": "^1.11.3",
    "tailwindcss": "^3.4.14",
    "vazirmatn": "^33.0.3"
  }
}
