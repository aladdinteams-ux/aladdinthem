# Persian (fa_IR) — Aladdin Theme
msgid ""
msgstr ""
"Project-Id-Version: payab-sanat-asa-core 1.0.0\n"
"Language: fa_IR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
