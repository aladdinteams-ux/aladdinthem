msgid "Nothing found."
msgstr "چیزی پیدا نشد."

msgid "Page not found"
msgstr "صفحه پیدا نشد"

msgid "The page you are looking for does not exist or has moved."
msgstr "صفحه‌ای که دنبال آن هستید وجود ندارد یا جابه‌جا شده است."

msgid "Back to home"
msgstr "بازگشت به صفحه اصلی"

